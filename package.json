{
  "name": "dsh-model-quota",
  "version": "1.0.0",
  "description": "DeepSeek Harness (DSH) 插件：侧栏常驻「模型余额与额度」卡片 + 面板 —— 跟随当前对话的模型商显示账户余额 / 赠金 / 5 小时·每周·每月套餐窗口；支持 DeepSeek Account、DeepSeek API、OpenCode Go、GLM/Z.AI Coding、Kimi Code、Moonshot、OpenRouter、SiliconFlow、MiniMax、StepFun、xAI。密钥只在宿主进程内使用。",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "tests/"
  ],
  "scripts": {
    "test": "node --test tests/quota.test.mjs"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "quota",
    "balance",
    "usage",
    "opencode",
    "glm",
    "kimi",
    "moonshot",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leafmy/dsh-model-quota.git"
  },
  "bugs": {
    "url": "https://github.com/Leafmy/dsh-model-quota/issues"
  },
  "homepage": "https://github.com/Leafmy/dsh-model-quota#readme",
  "license": "MIT"
}
